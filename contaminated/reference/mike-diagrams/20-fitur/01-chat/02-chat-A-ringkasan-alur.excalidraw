 585.8, "width": 313.2, "height": 112.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["cd58a0e15b754033b6e9"], "frameId": null, "roundness": null, "seed": 195060879, "version": 1, "versionNonce": 1440951249, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "GET /chat/:chatId mengembalikan active_turn\n  {id, seq, assistant_message_id}\nGET /chat/:chatId/turn/:turnId/stream?from=N\n→ frame seq ≥ N diputar ulang, lalu live\nCukup bisa MELIHAT chat untuk attach;\nmengirim/Stop butuh hak tulis.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "GET /chat/:chatId mengembalikan active_turn\n  {id, seq, assistant_message_id}\nGET /chat/:chatId/turn/:turnId/stream?from=N\n→ frame seq ≥ N diputar ulang, lalu live\nCukup bisa MELIHAT chat untuk attach;\nmengirim/Stop butuh hak tulis.", "autoResize": true, "lineHeight": 1.25}, {"id": "f7f1b534773f4d0f9b77", "type": "rectangle", "x": 1318, "y": 540, "width": 585, "height": 172.2, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["080bda52385a447a8adb"], "frameId": null, "roundness": {"type": 3}, "seed": 1642242337, "version": 1, "versionNonce": 1179175916, "isDeleted": false, "boundElements": [], "updated": 1793419172467, "link": null, "locked": false}, {"id": "f0f799a6d7654f73aaeb", "type": "text", "x": 1332, "y": 554, "width": 286.1, "height": 23.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["080bda52385a447a8adb"], "frameId": null, "roundness": null, "seed": 695008499, "version": 1, "versionNonce": 210015072, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "ask_inputs (jeda yang disengaja)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ask_inputs (jeda yang disengaja)", "autoResize": true, "lineHeight": 1.25}, {"id": "5ce6b2986a8c4a3a8479", "type": "text", "x": 1332, "y": 585.8, "width": 334.2, "height": 112.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["080bda52385a447a8adb"], "frameId": null, "roundness": null, "seed": 1770012365, "version": 1, "versionNonce": 38351015, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Model memanggil ask_inputs → giliran dijeda\n  (AssistantStreamAskInputsPause)\nUI menampilkan pilihan / teks / unggah dokumen\nJawaban: POST /chat + ask_inputs_response\n→ di-append ke pesan asisten yang sama\n→ aksi konektor yang disetujui jalan SEKALI", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Model memanggil ask_inputs → giliran dijeda\n  (AssistantStreamAskInputsPause)\nUI menampilkan pilihan / teks / unggah dokumen\nJawaban: POST /chat + ask_inputs_response\n→ di-append ke pesan asisten yang sama\n→ aksi konektor yang disetujui jalan SEKALI", "autoResize": true, "lineHeight": 1.25}, {"id": "9d6d6cd2bccb47868419", "type": "rectangle", "x": 1947, "y": 540, "width": 585, "height": 172.2, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["3c2bbafbaff84c46b284"], "frameId": null, "roundness": {"type": 3}, "seed": 358103601, "version": 1, "versionNonce": 1612577888, "isDeleted": false, "boundElements": [], "updated": 1793419172467, "link": null, "locked": false}, {"id": "8ef4d037895c4daf9e41", "type": "text", "x": 1961, "y": 554, "width": 141.4, "height": 23.8, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["3c2bbafbaff84c46b284"], "frameId": null, "roundness": null, "seed": 1279241335, "version": 1, "versionNonce": 786220572, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Error & deadline", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Error & deadline", "autoResize": true, "lineHeight": 1.25}, {"id": "cf03230b599e40aaaf5c", "type": "text", "x": 1961, "y": 585.8, "width": 379.6, "height": 112.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["3c2bbafbaff84c46b284"], "frameId": null, "roundness": null, "seed": 1964916938, "version": 1, "versionNonce": 940755338, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Idle 5 mnt tanpa progres / maks 4 jam → stop\nProvider: 2 mnt output pertama, 60 dtk antar-output\nError disimpan sebagai event error + frame error\nKunci API ditolak → code invalid_api_key\nPesan aman ditampilkan hanya untuk UserFacingError;\nselain itu teks generik.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Idle 5 mnt tanpa progres / maks 4 jam → stop\nProvider: 2 mnt output pertama, 60 dtk antar-output\nError disimpan sebagai event error + frame error\nKunci API ditolak → code invalid_api_key\nPesan aman ditampilkan hanya untuk UserFacingError;\nselain itu teks generik.", "autoResize": true, "lineHeight": 1.25}, {"id": "15934571531448b89e23", "type": "rectangle", "x": 60, "y": 810, "width": 585, "height": 172.2, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["a91ff42124164b4cb237"], "frameId": null, "roundness": {"type": 3}, "seed": 330408845, "version": 1, "versionNonce": 1812964852, "isDeleted": false, "boundElements": [], "updated": 1793419172467, "link": null, "locked": false}, {"id": "bf913b2f73a148988931", "type": "text", "x": 74, "y": 824, "width": 195.8, "height": 23.8, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["a91ff42124164b4cb237"], "frameId": null, "roundness": null, "seed": 1315176313, "version": 1, "versionNonce": 997201735, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Chat standalone  /chat", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Chat standalone  /chat", "autoResize": true, "lineHeight": 1.25}, {"id": "fb4d86d0f45d4e8da644", "type": "text", "x": 74, "y": 855.8, "width": 320.1, "height": 112.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["a91ff42124164b4cb237"], "frameId": null, "roundness": null, "seed": 1535994848, "version": 1, "versionNonce": 1431462510, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Dokumen: lampiran + dokumen yang dibuat\n  di giliran sebelumnya\nTool tulis dokumen → library milik user\nMemory: memory.md user untuk workspace itu\nFitur penuh: subagent, web search,\n  CourtListener, workflow, playbook, konektor", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Dokumen: lampiran + dokumen yang dibuat\n  di giliran sebelumnya\nTool tulis dokumen → library milik user\nMemory: memory.md user untuk workspace itu\nFitur penuh: subagent, web search,\n  CourtListener, workflow, playbook, konektor", "autoResize": true, "lineHeight": 1.25}, {"id": "eaa8f88f5ec24fdf930d", "type": "rectangle", "x": 689, "y": 810, "width": 585, "height": 172.2, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["5241f8a623464347ac5c"], "frameId": null, "roundness": {"type": 3}, "seed": 289479628, "version": 1, "versionNonce": 1447810730, "isDeleted": false, "boundElements": [], "updated": 1793419172467, "link": null, "locked": false}, {"id": "5fcd9c6140344623af09", "type": "text", "x": 703, "y": 833.4, "width": 256.7, "height": 23.8, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["5241f8a623464347ac5c"], "frameId": null, "roundness": null, "seed": 420051336, "version": 1, "versionNonce": 1134613065, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Project chat  /projects/:id/chat", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Project chat  /projects/:id/chat", "autoResize": true, "lineHeight": 1.25}, {"id": "6f05190fa50c46e0b8c7", "type": "text", "x": 703, "y": 865.1, "width": 335.5, "height": 93.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["5241f8a623464347ac5c"], "frameId": null, "roundness": null, "seed": 517667929, "version": 1, "versionNonce": 1965306507, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "extraTools = PROJECT_EXTRA_TOOLS\n  (list_documents, fetch_documents)\nHak TULIS dokumen ditentukan peran PROYEK,\n  bukan peran di thread (viewer = read-only)\nMemory proyek bersama (bila diaktifkan)", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "extraTools = PROJECT_EXTRA_TOOLS\n  (list_documents, fetch_documents)\nHak TULIS dokumen ditentukan peran PROYEK,\n  bukan peran di thread (viewer = read-only)\nMemory proyek bersama (bila diaktifkan)", "autoResize": true, "lineHeight": 1.25}, {"id": "1caa0c86313f4409a620", "type": "rectangle", "x": 1318, "y": 810, "width": 585, "height": 172.2, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["a7f09ddaab27472fa847"], "frameId": null, "roundness": {"type": 3}, "seed": 1705418582, "version": 1, "versionNonce": 629558955, "isDeleted": false, "boundElements": [], "updated": 1793419172467, "link": null, "locked": false}, {"id": "a4f447f7271547d0909a", "type": "text", "x": 1332, "y": 824, "width": 191.0, "height": 23.8, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["a7f09ddaab27472fa847"], "frameId": null, "roundness": null, "seed": 315417078, "version": 1, "versionNonce": 824867992, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Word chat  /word-chat", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Word chat  /word-chat", "autoResize": true, "lineHeight": 1.25}, {"id": "e2e461b1a4c146f99672", "type": "text", "x": 1332, "y": 855.8, "width": 307.5, "height": 112.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["a7f09ddaab27472fa847"], "frameId": null, "roundness": null, "seed": 2123198695, "version": 1, "versionNonce": 182882129, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Client tools: read_active_document,\n  apply_word_edits → SSE client_tool_call\n  → pane eksekusi (Office.js) → /tool-result\nChat cloud atau lokal (tak tersimpan)\nHanya workspace Personal; tanpa subagent,\n  web search, CourtListener", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Client tools: read_active_document,\n  apply_word_edits → SSE client_tool_call\n  → pane eksekusi (Office.js) → /tool-result\nChat cloud atau lokal (tak tersimpan)\nHanya workspace Personal; tanpa subagent,\n  web search, CourtListener", "autoResize": true, "lineHeight": 1.25}, {"id": "105acc1fd9e243baa202", "type": "rectangle", "x": 1947, "y": 810, "width": 585, "height": 172.2, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["8165e6b49eeb465e8623"], "frameId": null, "roundness": {"type": 3}, "seed": 812546569, "version": 1, "versionNonce": 1158152123, "isDeleted": false, "boundElements": [], "updated": 1793419172467, "link": null, "locked": false}, {"id": "d86e2d6b871740cb898d", "type": "text", "x": 1961, "y": 824, "width": 314.3, "height": 23.8, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["8165e6b49eeb465e8623"], "frameId": null, "roundness": null, "seed": 430240058, "version": 1, "versionNonce": 1654744744, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Tabular chat  /tabular-review/:id/chat", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Tabular chat  /tabular-review/:id/chat", "autoResize": true, "lineHeight": 1.25}, {"id": "dbf647c8c2d540f9af34", "type": "text", "x": 1961, "y": 855.8, "width": 261.1, "height": 112.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["8165e6b49eeb465e8623"], "frameId": null, "roundness": null, "seed": 592581582, "version": 1, "versionNonce": 424448542, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "TABULAR_TOOLS: read_table_cells\nbuildCitations kustom (sel, bukan doc)\nRun key tabular:<chatId> (tak bentrok\n  dengan chat id yang sama)\nThread review = creator-write; tanpa\n  subagent, web search", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "TABULAR_TOOLS: read_table_cells\nbuildCitations kustom (sel, bukan doc)\nRun key tabular:<chatId> (tak bentrok\n  dengan chat id yang sama)\nThread review = creator-write; tanpa\n  subagent, web search", "autoResize": true, "lineHeight": 1.25}, {"id": "5d4fab1320714035aaee", "type": "rectangle", "x": 60, "y": 1080, "width": 2472, "height": 116.0, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["fc6c539460ca4f519cb1"], "frameId": null, "roundness": {"type": 3}, "seed": 1099401348, "version": 1, "versionNonce": 1681997343, "isDeleted": false, "boundElements": [], "updated": 1793419172467, "link": null, "locked": false}, {"id": "c9164edf113e4cdea942", "type": "text", "x": 74, "y": 1094, "width": 229.5, "height": 23.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["fc6c539460ca4f519cb1"], "frameId": null, "roundness": null, "seed": 648189328, "version": 1, "versionNonce": 2048940879, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Invarian yang perlu diingat", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Invarian yang perlu diingat", "autoResize": true, "lineHeight": 1.25}, {"id": "acd8c30abd194698a2a0", "type": "text", "x": 74, "y": 1125.8, "width": 1395.4, "height": 56.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["fc6c539460ca4f519cb1"], "frameId": null, "roundness": null, "seed": 696356624, "version": 1, "versionNonce": 723831333, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "• Satu run per chat — POST kedua saat masih generating → 409 turn_in_progress.   • Run hidup di MEMORI proses: reconnect harus sampai ke replika yang sama (satu replika / sticky routing).\n• Tool yang tidak diiklankan ≠ tidak bisa dipanggil: runTools memfilter ulang (allowDocumentMutation, tool subagent).   • Isi dokumen/halaman web = DATA (dibungkus nonce spotlight), bukan instruksi.\n• Setiap baca dokumen memeriksa ulang akses; kemampuan chat tidak pernah memberi akses ke file.   • Frame error disaring: pesan tool/provider mentah tidak sampai ke UI (sanitizeAssistantSseChunk).", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Satu run per chat — POST kedua saat masih generating → 409 turn_in_progress.   • Run hidup di MEMORI proses: reconnect harus sampai ke replika yang sama (satu replika / sticky routing).\n• Tool yang tidak diiklankan ≠ tidak bisa dipanggil: runTools memfilter ulang (allowDocumentMutation, tool subagent).   • Isi dokumen/halaman web = DATA (dibungkus nonce spotlight), bukan instruksi.\n• Setiap baca dokumen memeriksa ulang akses; kemampuan chat tidak pernah memberi akses ke file.   • Frame error disaring: pesan tool/provider mentah tidak sampai ke UI (sanitizeAssistantSseChunk).", "autoResize": true, "lineHeight": 1.25}, {"id": "63f978fb33ff4aec851d", "type": "text", "x": 60, "y": 20, "width": 1123.1, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 511675921, "version": 1, "versionNonce": 713228343, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Chat — ringkasan 6 fase satu giliran + jalur samping + varian per permukaan", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Chat — ringkasan 6 fase satu giliran + jalur samping + varian per permukaan", "autoResize": true, "lineHeight": 1.25}, {"id": "b91d2453d779458c86cf", "type": "text", "x": 60, "y": 66, "width": 859.8, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1441862855, "version": 1, "versionNonce": 635440149, "isDeleted": false, "boundElements": null, "updated": 1793419172467, "link": null, "locked": false, "text": "Mulailah dari sini, lalu buka diagram B (sequence), C (loop mesin), D (protokol SSE), E (konteks & keamanan prompt)", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Mulailah dari sini, lalu buka diagram B (