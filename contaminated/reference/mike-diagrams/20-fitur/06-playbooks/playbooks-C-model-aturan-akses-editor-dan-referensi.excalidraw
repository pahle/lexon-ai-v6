 "versionNonce": 621438611, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "dokumen referensi MILIK playbook (salinan)\nfile_type docx|pdf · size_bytes > 0\nextracted_text · text_length\nmaks 20 per playbook\nstorage: playbooks/<creator>/<playbook>/sources/", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "dokumen referensi MILIK playbook (salinan)\nfile_type docx|pdf · size_bytes > 0\nextracted_text · text_length\nmaks 20 per playbook\nstorage: playbooks/<creator>/<playbook>/sources/", "autoResize": true, "lineHeight": 1.25}, {"id": "955a9a4fc4f94e9eb4a8", "type": "rectangle", "x": 800, "y": 400, "width": 1060, "height": 92.2, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["6b6e8f6e518a44c89f5b"], "frameId": null, "roundness": {"type": 3}, "seed": 1427690163, "version": 1, "versionNonce": 1254584340, "isDeleted": false, "boundElements": [], "updated": 1793419176242, "link": null, "locked": false}, {"id": "dfacbb2007ce4827bc47", "type": "text", "x": 814, "y": 414, "width": 445.9, "height": 23.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["6b6e8f6e518a44c89f5b"], "frameId": null, "roundness": null, "seed": 426888520, "version": 1, "versionNonce": 970932009, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "playbook_shares · playbook_org_access_overrides", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "playbook_shares · playbook_org_access_overrides", "autoResize": true, "lineHeight": 1.25}, {"id": "571329dae4044688a6cb", "type": "text", "x": 814, "y": 445.8, "width": 570.2, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["6b6e8f6e518a44c89f5b"], "frameId": null, "roundness": null, "seed": 1492937162, "version": 1, "versionNonce": 902371123, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "personal: email (lowercase) + role owner|editor|viewer (default viewer)\norg: override per anggota, termasuk deny", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "personal: email (lowercase) + role owner|editor|viewer (default viewer)\norg: override per anggota, termasuk deny", "autoResize": true, "lineHeight": 1.25}, {"id": "bb352a5c58f7485b88a0", "type": "rectangle", "x": 60, "y": 620, "width": 2340, "height": 189.8, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["26664a561332428782c2"], "frameId": null, "roundness": {"type": 3}, "seed": 1706127351, "version": 1, "versionNonce": 1426445631, "isDeleted": false, "boundElements": [], "updated": 1793419176242, "link": null, "locked": false}, {"id": "702d3fe80ed34e879935", "type": "text", "x": 74, "y": 634, "width": 301.3, "height": 23.8, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["26664a561332428782c2"], "frameId": null, "roundness": null, "seed": 457972369, "version": 1, "versionNonce": 667935501, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "Struktur satu aturan (content_json)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Struktur satu aturan (content_json)", "autoResize": true, "lineHeight": 1.25}, {"id": "5f9d8ba958d64e5bb0ae", "type": "text", "x": 74, "y": 665.8, "width": 746.7, "height": 130.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["26664a561332428782c2"], "frameId": null, "roundness": null, "seed": 1214815719, "version": 1, "versionNonce": 636617981, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "topik (opsional) → aturan; panduan yang berlaku umum = aturan juga\nsetiap aturan: konsep yang dikenali (lingkup klausul / perjanjian) · wajib/opsional\n  posisi standar · fallback · tidak dapat diterima · contoh klausul (ilustratif/disukai/verbatim/diterima/ditolak)\n  kondisi · panduan reviewer · aksi eskalasi\n  referensi sumber → paragraf / sel tabel Word yang diimpor  (aturan hasil impor WAJIB punya ≥1 referensi nyata)\naturan tulis-tangan: tanpa referensi sumber (pemeriksaan ketat hanya untuk impor terkompilasi)\nAutosave menerima field belum lengkap; menjalankan review membutuhkan aturan lengkap. Tidak ada 'publish' / nomor versi:\n  review memakai aturan tersimpan TERBARU dan menyimpan snapshot → edit kemudian tak mengubah review lama.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "topik (opsional) → aturan; panduan yang berlaku umum = aturan juga\nsetiap aturan: konsep yang dikenali (lingkup klausul / perjanjian) · wajib/opsional\n  posisi standar · fallback · tidak dapat diterima · contoh klausul (ilustratif/disukai/verbatim/diterima/ditolak)\n  kondisi · panduan reviewer · aksi eskalasi\n  referensi sumber → paragraf / sel tabel Word yang diimpor  (aturan hasil impor WAJIB punya ≥1 referensi nyata)\naturan tulis-tangan: tanpa referensi sumber (pemeriksaan ketat hanya untuk impor terkompilasi)\nAutosave menerima field belum lengkap; menjalankan review membutuhkan aturan lengkap. Tidak ada 'publish' / nomor versi:\n  review memakai aturan tersimpan TERBARU dan menyimpan snapshot → edit kemudian tak mengubah review lama.", "autoResize": true, "lineHeight": 1.25}, {"id": "bee819ed67e942ffa175", "type": "rectangle", "x": 60, "y": 880, "width": 1140, "height": 238.5, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["437774153e14498f80ed"], "frameId": null, "roundness": {"type": 3}, "seed": 385424025, "version": 1, "versionNonce": 1566085536, "isDeleted": false, "boundElements": [], "updated": 1793419176242, "link": null, "locked": false}, {"id": "0dfabfdcd7084758b131", "type": "text", "x": 74, "y": 894, "width": 226.2, "height": 23.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["437774153e14498f80ed"], "frameId": null, "roundness": null, "seed": 413567744, "version": 1, "versionNonce": 293247641, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "Akses (playbooks.access)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Akses (playbooks.access)", "autoResize": true, "lineHeight": 1.25}, {"id": "c891608396b14cdba6cd", "type": "text", "x": 74, "y": 925.8, "width": 436.6, "height": 178.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["437774153e14498f80ed"], "frameId": null, "roundness": null, "seed": 1061350892, "version": 1, "versionNonce": 1632322166, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "Seperti workflows, dengan dua beda:\n• playbook PUBLIK memberi anggota org Viewer, bukan Editor\n  (aturan = kebijakan org; hak edit diberikan per orang; ada daftar deny)\n• owner org TIDAK mengambil alih playbook privat yang pembuatnya\n  sudah pergi; admin tak punya akses privat berjejak\npersonal: pembuat=owner; penerima = peran yang diberikan\n  (hanya akun yang sudah ada, via email, tanpa email notifikasi)\norg: anggota wajib (pembuat pun); pembuat=owner; owner org\n  memiliki yang publik; deny=tak ada; override=perannya\nViewer: lihat + jalankan review · Editor: + ubah aturan/detail/\n  referensi, replace dari berkas · Owner: + bagikan, ubah visibilitas, hapus", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Seperti workflows, dengan dua beda:\n• playbook PUBLIK memberi anggota org Viewer, bukan Editor\n  (aturan = kebijakan org; hak edit diberikan per orang; ada daftar deny)\n• owner org TIDAK mengambil alih playbook privat yang pembuatnya\n  sudah pergi; admin tak punya akses privat berjejak\npersonal: pembuat=owner; penerima = peran yang diberikan\n  (hanya akun yang sudah ada, via email, tanpa email notifikasi)\norg: anggota wajib (pembuat pun); pembuat=owner; owner org\n  memiliki yang publik; deny=tak ada; override=perannya\nViewer: lihat + jalankan review · Editor: + ubah aturan/detail/\n  referensi, replace dari berkas · Owner: + bagikan, ubah visibilitas, hapus", "autoResize": true, "lineHeight": 1.25}, {"id": "7af1c03aa8f548d9ac4c", "type": "rectangle", "x": 1260, "y": 880, "width": 1140, "height": 238.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["52bbdc9200a348d094d9"], "frameId": null, "roundness": {"type": 3}, "seed": 2011601603, "version": 1, "versionNonce": 1615671366, "isDeleted": false, "boundElements": [], "updated": 1793419176242, "link": null, "locked": false}, {"id": "beca9661378f4539bd34", "type": "text", "x": 1274, "y": 918.4, "width": 109.8, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["52bbdc9200a348d094d9"], "frameId": null, "roundness": null, "seed": 1436201935, "version": 1, "versionNonce": 1598057964, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "Cara dipakai", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Cara dipakai", "autoResize": true, "lineHeight": 1.25}, {"id": "2e68c49a303444719bfd", "type": "text", "x": 1274, "y": 950.1, "width": 786.6, "height": 130.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["52bbdc9200a348d094d9"], "frameId": null, "roundness": null, "seed": 541777275, "version": 1, "versionNonce": 22722785, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "Editor: panel aturan (kiri) + form aturan (kanan); toolbar Rules · References · Runs\nReview: POST /:id/review → job playbook.review (lihat B); Runs tab: 50 terakhir per playbook, 100 lintas playbook\nAsisten: pill playbook di composer → pesan membawa playbook:{id,title}; mesin memanggil run_playbook\n  (akses dicek ULANG); review dari chat berjalan di dalam giliran chat, bukan sebagai job\nWord add-in: composer punya item Playbooks (hanya yang PERSONAL dan bisa dibuka); POST /word-chat 404 bila tak bisa dibuka;\n  review membaca teks dokumen terbuka (tanpa versi baru): temuan kembali di chat, lalu minta edit Word\nReferensi: daftar id/nama/panjang masuk prompt; model memanggil read_supplementary_document (potongan ≤40.000 karakter),\n  hanya dokumen milik playbook itu. Tanpa referensi → satu panggilan model.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Editor: panel aturan (kiri) + form aturan (kanan); toolbar Rules · References · Runs\nReview: POST /:id/review → job playbook.review (lihat B); Runs tab: 50 terakhir per playbook, 100 lintas playbook\nAsisten: pill playbook di composer → pesan membawa playbook:{id,title}; mesin memanggil run_playbook\n  (akses dicek ULANG); review dari chat berjalan di dalam giliran chat, bukan sebagai job\nWord add-in: composer punya item Playbooks (hanya yang PERSONAL dan bisa dibuka); POST /word-chat 404 bila tak bisa dibuka;\n  review membaca teks dokumen terbuka (tanpa versi baru): temuan kembali di chat, lalu minta edit Word\nReferensi: daftar id/nama/panjang masuk prompt; model memanggil read_supplementary_document (potongan ≤40.000 karakter),\n  hanya dokumen milik playbook itu. Tanpa referensi → satu panggilan model.", "autoResize": true, "lineHeight": 1.25}, {"id": "ae4956d5f2cf4ae18ce6", "type": "rectangle", "x": 60, "y": 1220, "width": 2340, "height": 107.2, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["7466ca2b22cf4f4a9298"], "frameId": null, "roundness": {"type": 3}, "seed": 1684660182, "version": 1, "versionNonce": 1714516457, "isDeleted": false, "boundElements": [], "updated": 1793419176242, "link": null, "locked": false}, {"id": "60853a6ba5924c3daa51", "type": "text", "x": 74, "y": 1234, "width": 202.1, "height": 22.5, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["7466ca2b22cf4f4a9298"], "frameId": null, "roundness": null, "seed": 90520174, "version": 1, "versionNonce": 724703304, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "Penghapusan akun / org", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Penghapusan akun / org", "autoResize": true, "lineHeight": 1.25}, {"id": "64b2feb38c6949118f40", "type": "text", "x": 74, "y": 1264.5, "width": 1015.5, "height": 48.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["7466ca2b22cf4f4a9298"], "frameId": null, "roundness": null, "seed": 1380294796, "version": 1, "versionNonce": 317663534, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "Playbook PUBLIK milik pembuat yang menghapus akun → pindah ke owner org penerus (beserta run orang lain & berkasnya).\nPlaybook privat/personal, import & review yang ia jalankan, dan share atas namanya → ikut terhapus. Owner org bisa menghapus semua playbook dari Privacy & data org.\nBerkas storage dibersihkan oleh trigger DB + job (gagal diulang); akun juga menyapu playbooks/<user>/ yang tak diklaim (unggahan staged yatim).", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Playbook PUBLIK milik pembuat yang menghapus akun → pindah ke owner org penerus (beserta run orang lain & berkasnya).\nPlaybook privat/personal, import & review yang ia jalankan, dan share atas namanya → ikut terhapus. Owner org bisa menghapus semua playbook dari Privacy & data org.\nBerkas storage dibersihkan oleh trigger DB + job (gagal diulang); akun juga menyapu playbooks/<user>/ yang tak diklaim (unggahan staged yatim).", "autoResize": true, "lineHeight": 1.25}, {"id": "034bad89b22042a68070", "type": "text", "x": 60, "y": 20, "width": 1124.9, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1070887648, "version": 1, "versionNonce": 517302281, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "Playbooks C — model data, struktur aturan, akses, referensi, dan pemakaian", "fontSize": 32, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Playbooks C — model data, struktur aturan, akses, referensi, dan pemakaian", "autoResize": true, "lineHeight": 1.25}, {"id": "690c3a3ce00c4e7aa786", "type": "text", "x": 60, "y": 66, "width": 1364.8, "height": 20.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 26739040, "version": 1, "versionNonce": 1421812882, "isDeleted": false, "boundElements": null, "updated": 1793419176242, "link": null, "locked": false, "text": "docs/playbooks.md · modules/playbooks (access · sharing · sources · staging · operations · word) · schema playbooks / playbook_runs / imports / sources / shares / org_access_overrides", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "docs/playbooks.md · modules/playbooks (access · sharing · sources · staging · operations · word) · schema playbooks / playbook_runs / imports / sources / shares / org_access_overrides", "autoResize": true, "lineHeight": 1.25}, {"id": "a49973241ff545d7a882", "type": "arrow", "x": 700, "y": 248.6, "width": 100, "height": 8.1, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 125390925, "version": 1, "versionNonce": 730