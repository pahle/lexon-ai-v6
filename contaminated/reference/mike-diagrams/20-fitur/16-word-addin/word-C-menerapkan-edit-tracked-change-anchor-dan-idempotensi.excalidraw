eStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1053186003, "version": 1, "versionNonce": 1567481549, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "APPLYTRACKEDEDITS — SATU EDIT DI DOKUMEN (Word.run, WordApi 1.6)", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "APPLYTRACKEDEDITS — SATU EDIT DI DOKUMEN (Word.run, WordApi 1.6)", "autoResize": true, "lineHeight": 1.25}, {"id": "21c91e2502114df898f7", "type": "rectangle", "x": 60, "y": 170, "width": 2340, "height": 129.8, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b37da5bb7ea74173acfc"], "frameId": null, "roundness": {"type": 3}, "seed": 605463881, "version": 1, "versionNonce": 1243257590, "isDeleted": false, "boundElements": [], "updated": 1793419178308, "link": null, "locked": false}, {"id": "539e0cdbeb23450c9aa2", "type": "text", "x": 74, "y": 184, "width": 445.9, "height": 23.8, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b37da5bb7ea74173acfc"], "frameId": null, "roundness": null, "seed": 1682995137, "version": 1, "versionNonce": 1674977228, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "Dua kanal usulan edit → satu kartu & satu baris DB", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Dua kanal usulan edit → satu kartu & satu baris DB", "autoResize": true, "lineHeight": 1.25}, {"id": "76c6ad5de28b4b0fa9bb", "type": "text", "x": 74, "y": 215.8, "width": 1022.7, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b37da5bb7ea74173acfc"], "frameId": null, "roundness": null, "seed": 605808103, "version": 1, "versionNonce": 1383026977, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "Kanal tool (pane baru): apply_word_edits → block_index mulai 1000 (TOOL_EDIT_INDEX_BASE; backend memberi ordinal pertama, pane memakainya)\nKanal teks (pane lama): blok <EDITS> di jawaban → block_index 0… (lib/redline parse)  — dua kanal tak mungkin bertabrakan\nSatu edit = {original (≤200 karakter, kutipan persis), replacement XOR formats[bold|italic|underline|gaya heading], occurrence?: 'all', reason}\nID stabil: `${assistantMessageId}:edit-${blockIndex}`  → kunci kartu, id bookmark tersembunyi, dan baris word_document_edits (unik per message+block_index)", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Kanal tool (pane baru): apply_word_edits → block_index mulai 1000 (TOOL_EDIT_INDEX_BASE; backend memberi ordinal pertama, pane memakainya)\nKanal teks (pane lama): blok <EDITS> di jawaban → block_index 0… (lib/redline parse)  — dua kanal tak mungkin bertabrakan\nSatu edit = {original (≤200 karakter, kutipan persis), replacement XOR formats[bold|italic|underline|gaya heading], occurrence?: 'all', reason}\nID stabil: `${assistantMessageId}:edit-${blockIndex}`  → kunci kartu, id bookmark tersembunyi, dan baris word_document_edits (unik per message+block_index)", "autoResize": true, "lineHeight": 1.25}, {"id": "74007691523c4b91b9a5", "type": "rectangle", "x": 60, "y": 375, "width": 620, "height": 189.8, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["fafac007410d4ec5b614"], "frameId": null, "roundness": {"type": 3}, "seed": 720693573, "version": 1, "versionNonce": 618312691, "isDeleted": false, "boundElements": [], "updated": 1793419178308, "link": null, "locked": false}, {"id": "9b63abca4b4c46e3bf74", "type": "text", "x": 74, "y": 405.2, "width": 214.1, "height": 23.8, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["fafac007410d4ec5b614"], "frameId": null, "roundness": null, "seed": 1005824034, "version": 1, "versionNonce": 2111493107, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "Mode 'approval' (default)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Mode 'approval' (default)", "autoResize": true, "lineHeight": 1.25}, {"id": "110e7c50914544d2b8b5", "type": "text", "x": 74, "y": 437.0, "width": 294.8, "height": 97.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["fafac007410d4ec5b614"], "frameId": null, "roundness": null, "seed": 1323888153, "version": 1, "versionNonce": 165567450, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "validateTrackedEdit: cari teks di dokumen HIDUP,\n  dokumen TIDAK diubah\nkartu 'proposed' siap — hasil sukses di mode ini\nrevealProposedEdit: sorot teks di dokumen\nuser klik Terapkan → acceptAndApplyEdit\n  → jalur yang sama dengan mode direct", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "validateTrackedEdit: cari teks di dokumen HIDUP,\n  dokumen TIDAK diubah\nkartu 'proposed' siap — hasil sukses di mode ini\nrevealProposedEdit: sorot teks di dokumen\nuser klik Terapkan → acceptAndApplyEdit\n  → jalur yang sama dengan mode direct", "autoResize": true, "lineHeight": 1.25}, {"id": "c3fb308b0ca34fa789ea", "type": "rectangle", "x": 720, "y": 375, "width": 620, "height": 189.8, "angle": 0, "strokeColor": "#d9480f", "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ceb982aa99894143ad2c"], "frameId": null, "roundness": {"type": 3}, "seed": 88667079, "version": 1, "versionNonce": 2141395328, "isDeleted": false, "boundElements": [], "updated": 1793419178308, "link": null, "locked": false}, {"id": "2e1a59116db241cebc8e", "type": "text", "x": 734, "y": 405.2, "width": 109.7, "height": 23.8, "angle": 0, "strokeColor": "#d9480f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ceb982aa99894143ad2c"], "frameId": null, "roundness": null, "seed": 570475106, "version": 1, "versionNonce": 107161007, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "Mode 'direct'", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Mode 'direct'", "autoResize": true, "lineHeight": 1.25}, {"id": "3238e79caa5e414abd9f", "type": "text", "x": 734, "y": 437.0, "width": 294.3, "height": 97.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ceb982aa99894143ad2c"], "frameId": null, "roundness": null, "seed": 1176260388, "version": 1, "versionNonce": 328223473, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "scheduleDirectEdit: edit langsung diterapkan\n  begitu ditayangkan / diterima dari tool\nmenjadi tracked change TERTUNDA di dokumen;\n  tetap bisa diterima/ditolak per kartu\ndiserialkan: semua mutasi Word lewat satu\n  antrean (serializeWordMutation)", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "scheduleDirectEdit: edit langsung diterapkan\n  begitu ditayangkan / diterima dari tool\nmenjadi tracked change TERTUNDA di dokumen;\n  tetap bisa diterima/ditolak per kartu\ndiserialkan: semua mutasi Word lewat satu\n  antrean (serializeWordMutation)", "autoResize": true, "lineHeight": 1.25}, {"id": "29363a0ecfdc47568d97", "type": "rectangle", "x": 1380, "y": 375, "width": 720, "height": 189.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ba1b2c4806d8462c9aa4"], "frameId": null, "roundness": {"type": 3}, "seed": 1698697571, "version": 1, "versionNonce": 123115562, "isDeleted": false, "boundElements": [], "updated": 1793419178308, "link": null, "locked": false}, {"id": "c70396859e134aa29eed", "type": "text", "x": 1394, "y": 389, "width": 266.4, "height": 23.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ba1b2c4806d8462c9aa4"], "frameId": null, "roundness": null, "seed": 1691626382, "version": 1, "versionNonce": 1948003269, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "Hasil per edit ke model & kartu", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Hasil per edit ke model & kartu", "autoResize": true, "lineHeight": 1.25}, {"id": "0e24e5c950464c8387e2", "type": "text", "x": 1394, "y": 420.8, "width": 310.4, "height": 130.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ba1b2c4806d8462c9aa4"], "frameId": null, "roundness": null, "seed": 926776958, "version": 1, "versionNonce": 1812920406, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "proposed (menunggu manusia) · applied ·\n  applied-unmanaged (tracked change ada,\n  revisi persis tak bisa dipertahankan) · failed ·\n  skipped(already-applied | unsearchable |\n  ambiguous | pre-existing-revisions) · not-found\n'unknown' disintesis BACKEND (pane tak menjawab\n  tepat waktu): model harus verifikasi dulu,\n  BUKAN retry (retry menumpuk revisi kedua)", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "proposed (menunggu manusia) · applied ·\n  applied-unmanaged (tracked change ada,\n  revisi persis tak bisa dipertahankan) · failed ·\n  skipped(already-applied | unsearchable |\n  ambiguous | pre-existing-revisions) · not-found\n'unknown' disintesis BACKEND (pane tak menjawab\n  tepat waktu): model harus verifikasi dulu,\n  BUKAN retry (retry menumpuk revisi kedua)", "autoResize": true, "lineHeight": 1.25}, {"id": "33ed52a4d15d448497c2", "type": "rectangle", "x": 60, "y": 640, "width": 430, "height": 172.2, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["0c32b2c637e04c33aefd"], "frameId": null, "roundness": {"type": 3}, "seed": 187724477, "version": 1, "versionNonce": 1117441132, "isDeleted": false, "boundElements": [{"id": "165e85d7910b4f89ace4", "type": "arrow"}], "updated": 1793419178308, "link": null, "locked": false}, {"id": "6a44ae99ad8949038643", "type": "text", "x": 74, "y": 670.2, "width": 127.8, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["0c32b2c637e04c33aefd"], "frameId": null, "roundness": null, "seed": 623122727, "version": 1, "versionNonce": 435119333, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "1 · Idempotensi", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1 · Idempotensi", "autoResize": true, "lineHeight": 1.25}, {"id": "c8bfe47ebdda487295ad", "type": "text", "x": 74, "y": 700.8, "width": 230.8, "height": 81.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["0c32b2c637e04c33aefd"], "frameId": null, "roundness": null, "seed": 594041492, "version": 1, "versionNonce": 1631361459, "isDeleted": false, "boundElements": null, "updated": 1793419178308, "link": null, "locked": false, "text": "ID stabil sudah ada di daftar\n'sudah diterapkan' (Office document\nsettings, maks 500, terlama dibuang)?\n→ skipped / already-applied\n(rejoin turn memutar ulang semua edit)", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ID stabil sudah ada di daftar\n'sudah diterapkan' (Office document\nsettings, maks 500, terlama dibuang)?\n→ skipped / already-applied\n(rejoin turn memutar ulang semua edit)", "autoResize": true, "lineHeight": 1.25}, {"id": "5cc82ef91538404e88b7", "type": "rectangle", "x": 530, "y": 640, "width": 430, "height": 172.2, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["70418458a90b4f758e19"], "frameId": null, "roundness": {"type": 3}, "seed": 1366285610, "version": 1, "versionNonce": 589468423, "isDeleted": false, "boundElements": [{"id": "165e85d7910b4f89ace4", "type": "arrow"}, {"id": "e7d9ec8c38ad4304979b", "type": "arrow"}], "updated": 1793419178308, "link": null, "locked": false}, {"id": "75d25de2aea04