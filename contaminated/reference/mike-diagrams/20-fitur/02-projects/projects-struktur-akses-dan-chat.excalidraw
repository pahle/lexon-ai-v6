406.4, "width": 433.7, "height": 81.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["653077c127ba4e18aa41"], "frameId": null, "roundness": null, "seed": 1298866967, "version": 1, "versionNonce": 1409047109, "isDeleted": false, "boundElements": null, "updated": 1793419176798, "link": null, "locked": false, "text": "viewer: project.view (baca, unduh, tonton stream)\neditor: + content.edit (chat, upload, edit, ekstraksi)\n         + docs.organize (rename/pindah, folder)\nowner: + access.manage + container.delete\ncan(role, kapabilitas) — satu tabel, fail-closed", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "viewer: project.view (baca, unduh, tonton stream)\neditor: + content.edit (chat, upload, edit, ekstraksi)\n         + docs.organize (rename/pindah, folder)\nowner: + access.manage + container.delete\ncan(role, kapabilitas) — satu tabel, fail-closed", "autoResize": true, "lineHeight": 1.25}, {"id": "ceb5ee91e1e442c4a59e", "type": "rectangle", "x": 800, "y": 340, "width": 900, "height": 182.2, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["18fc343564aa4fa48058"], "frameId": null, "roundness": {"type": 3}, "seed": 1873579872, "version": 1, "versionNonce": 1649643387, "isDeleted": false, "boundElements": [], "updated": 1793419176798, "link": null, "locked": false}, {"id": "5d2da8f59e6e4000a13e", "type": "text", "x": 814, "y": 354, "width": 340.4, "height": 23.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["18fc343564aa4fa48058"], "frameId": null, "roundness": null, "seed": 1752396247, "version": 1, "vers