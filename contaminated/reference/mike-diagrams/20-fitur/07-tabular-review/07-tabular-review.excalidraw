"fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Generasi = run milik server (lib/streamRuns.ts), menulis lewat run.\nSSE frame cell_update per sel; reconnect: GET /:id/generate/stream.\nStop: POST /:id/generate/stop. Tanpa Redis tetap berjalan.", "autoResize": true, "lineHeight": 1.25}, {"id": "1b39e7491ebd4927a672", "type": "rectangle", "x": 1140, "y": 380, "width": 1040, "height": 112.2, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["fa72254f64144ddbb179"], "frameId": null, "roundness": {"type": 3}, "seed": 1953245685, "version": 1, "versionNonce": 1069977491, "isDeleted": false, "boundElements": [], "updated": 1793419173666, "link": null, "locked": false}, {"id": "426b8d2717f6405095d6", "type": "text", "x": 1154, "y": 394, "width": 500.4, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["fa72254f64144ddbb179"], "frameId": null, "roundness": null, "seed": 329810325, "version": 1, "versionNonce": 810742843, "isDeleted": false, "boundElements": null, "updated": 1793419173666, "link": null, "locked": false, "text": "Mode async (ASYNC_TABULAR_EXTRACTION + Redis)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Mode async (ASYNC_TABULAR_EXTRACTION + Redis)", "autoResize": true, "lineHeight": 1.25}, {"id": "95e88ef3e4b64667907f", "type": "text", "x": 1154, "y": 425.8, "width": 557.0, "height": 52.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["fa72254f64144ddbb179"], "frameId": null, "roundness": null, "seed": 443717904, "versi