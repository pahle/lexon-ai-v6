ss": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1832072263, "version": 1, "versionNonce": 118780422, "isDeleted": false, "boundElements": null, "updated": 1793419175965, "link": null, "locked": false, "text": "SIKLUS HIDUP ORGANISASI", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "SIKLUS HIDUP ORGANISASI", "autoResize": true, "lineHeight": 1.25}, {"id": "68a6be7c238c49ce9304", "type": "rectangle", "x": 60, "y": 130, "width": 2340, "height": 252.2, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["e18175122de844da99ee"], "frameId": null, "roundness": {"type": 3}, "seed": 1626480402, "version": 1, "versionNonce": 1437876429, "isDeleted": false, "boundElements": [], "updated": 1793419175965, "link": null, "locked": false}, {"id": "2a228960b7c54080981f", "type": "text", "x": 74, "y": 144, "width": 280.6, "height": 23.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["e18175122de844da99ee"], "frameId": null, "roundness": null, "seed": 371652419, "version": 1, "versionNonce": 588070904, "isDeleted": false, "boundElements": null, "updated": 1793419175965, "link": null, "locked": false, "text": "1 · Akses konten privat (audited)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1 · Akses konten privat (audited)", "autoResize": true, "lineHeight": 1.25}, {"id": "e54a9efd073b48298c08", "type": "text", "x": 74, "y": 175.8, "width": 783.1, "height": 192.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["e18175122de844da99ee"], "frameId": null, "roundness": null, "seed": 1381902922, "version": 1, "versionNonce": 1203882479, "isDeleted": false, "boundElements": null, "updated": 1793419175965, "link": null, "locked": false, "text": "Default: konten org PRIVAT bagi pembuatnya — owner pun tak otomatis melihat\n  (owner hanya memiliki yang publik/tanpa-owner; lihat project_access_role)\nPintu darurat resmi, hanya untuk: owner, atau admin dengan can_access_private_content\n  (flag di org_members; CHECK: hanya peran admin; otomatis mati bila peran berubah)\nPUT /members/:userId/private-content-permission {enabled} — owner menyalakan/mematikan per admin\nGET /private-content?search=&limit&offset → RPC list_org_private_content (katalog item aktif org saja:\n  project · workflow · chat · tabular_review · document; bukan personal / terarsip / lintas-org)\nPOST /private-content/:kind/:itemId/open → open_org_private_content:\n  satu transaksi: INSERT org_private_content_access (viewer) + audit_events 'org.private_content.opened'\n  — audit gagal = akses DITOLAK\nDELETE /private-content/:kind/:itemId → close_org_private_content (cabut akses + audit '…closed') — BUKAN hapus item", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Default: konten org PRIVAT bagi pembuatnya — owner pun tak otomatis melihat\n  (owner hanya memiliki yang publik/tanpa-owner; lihat project_access_role)\nPintu darurat resmi, hanya untuk: owner, atau admin dengan can_access_private_content\n  (flag di org_members; CHECK: hanya peran admin; otomatis mati bila peran berubah)\nPUT /members/:userId/private-content-permission {enabled} — owner menyalakan/mematikan per admin\nGET /private-content?search=&limit&offset → RPC list_org_private_content (katalog item aktif org saja:\n  project · workflow · chat · tabular_review · document; bukan personal / terarsip / lintas-org)\nPOST /private-content/:kind/:itemId/open → open_org_private_content:\n  satu transaksi: INSERT org_private_content_access (viewer) + audit_events 'org.private_content.opened'\n  — audit gagal = akses DITOLAK\nDELETE /private-content/:kind/:itemId → close_org_private_content (cabut akses + audit '…closed') — BUKAN hapus item", "autoResize": true, "lineHeight": 1.25}, {"id": "86f3f7f9cf654ad095fd", "type": "rectangle", "x": 60, "y": 430, "width": 760, "height": 253.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["be1833ae7e1840868e22"], "frameId": null, "roundness": {"type": 3}, "seed": 1804296521, "version": 1, "versionNonce": 602235527, "isDeleted": false, "boundElements": [], "updated": 1793419175965, "link": null, "locked": false}, {"id": "b6399b40d8db4dfcb13e", "type": "text", "x": 74, "y": 452.1, "width": 221.7, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["be1833ae7e1840868e22"], "frameId": null, "roundness": null, "seed": 312568489, "version": 1, "versionNonce": 676537168, "isDeleted": false, "boundElements": null, "updated": 1793419175965, "link": null, "locked": false, "text": "2 · Kebijakan data anggota", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2 · Kebijakan data anggota", "autoResize": true, "lineHeight": 1.25}, {"id": "1f3d352c29f946ebb90d", "type": "text", "x": 74, "y": 482.6, "width": 370.8, "height": 178.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["be1833ae7e1840868e22"], "frameId": null, "roundness": null, "seed": 1152062790, "version": 1, "versionNonce": 41134049, "isDeleted": false, "boundElements": null, "updated": 1793419175965, "link": null, "locked": false, "text": "organizations.allow_member_exports / allow_member_deletes\ndefault OFF · PUT /:orgId/member-data-policy — owner saja\nmemberDataActionAllowed: owner selalu boleh; anggota\n  hanya bila owner mengizinkan; non-anggota = false;\n  gagal baca = lempar error (tak menjawab ya/tidak)\nBerlaku untuk: Ekspor dan 'Hapus semua' di Settings\n  (lihat Privacy A/B). Hapus 1 item tak terpengaruh.\nDELETE /:orgId/data/:kind — OWNER menghapus satu jenis\n  konten SELURUH org: chats · tabular-reviews · projects\n  · memories · playbooks (halaman demi halaman, dilaporkan\n  gagal bila setengah jalan)", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "organizations.allow_member_exports / allow_member_deletes\ndefault OFF · PUT /:orgId/member-data-policy — owner saja\nmemberDataActionAllowed: owner selalu boleh; anggota\n  hanya bila owner mengizinkan; non-anggota = false;\n  gagal baca = lempar error (tak menjawab ya/tidak)\nBerlaku untuk: Ekspor dan 'Hapus semua' di Settings\n  (lihat Privacy A/B). Hapus 1 item tak terpengaruh.\nDELETE /:orgId/data/:kind — OWNER menghapus satu jenis\n  konten SELURUH org: chats · tabular-reviews · projects\n  · memories · playbooks (halaman demi halaman, dilaporkan\n  gagal bila setengah jalan)", "autoResize": true, "lineHeight": 1.25}, {"id": "5513d79e5c94440da553", "type": "rectangle", "x": 850, "y": 430, "width": 760, "height": 253.5, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["9851394bb27c4d0d90db"], "frameId": null, "roundness": {"type": 3}, "seed": 1121143190, "version": 1, "versionNonce": 1876562502, "isDeleted": false, "boundElements": [], "updated": 1793419175965, "link": null, "locked": false}, {"id": "9322de6b17e448248525", "type": "text", "x": 864, "y": 452.1, "width": 236.0, "height": 22.5, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["9851394bb27c4d0d90db"], "frameId": null, "roundness": null, "seed": 1369149092, "version": 1, "versionNonce": 1492517860, "isDeleted": false, "boundElements": null, "updated": 1793419175965, "link": null, "locked": false, "text": "3 · Kunci & model organisasi", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3 · Kunci & model organisasi", "autoResize": true, "lineHeight": 1.25}, {"id": "d0d7c095e56b4def936a", "type": "text", "x": 864, "y": 482.6, "width": 394.4, "height": 178.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["9851394bb27c4d0d90db"], "frameId": null, "roundness": null, "seed": 67099864, "version": 1, "versionNonce": 562948112, "isDeleted": false, "boundElements": null, "updated": 1793419175965, "link": null, "locked": false, "text": "org_api_keys: dienkripsi, disimpan via key-store user\n  yang sama (satu implementasi untuk orang & org)\nGET (anggota mana pun: provider mana yang siap, tanpa rahasia)\nPUT / PATCH / DELETE /:orgId/api-keys/:provider — owner/admin\nPUT …/:provider/models — admin memilih model untuk provider\n  berdaftar-model (OpenRouter, Bedrock, Azure, dst.)\nKerja DI org hanya memakai: kunci org → kunci server.\n  Kunci pribadi anggota TAK PERNAH dipakai (20261024_01);\n  token CourtListener pribadi untuk org itu tetap berlaku\n  (konektor, bukan kunci model).\nPerubahan tercatat di audit.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "org_api_keys: dienkripsi, disimpan via key-store user\n  yang sama (satu implementasi untuk orang & org)\nGET (anggota mana pun: provider mana yang siap, tanpa rahasia)\nPUT / PATCH / DELETE /:orgId/api-keys/:provider — owner/admin\nPUT …/:provider/models — admin memilih model untuk provider\n  berdaftar-model (OpenRouter, Bedrock, Azure, dst.)\nKerja DI org hanya memakai: kunci org → kunci server.\n  Kunci pribadi anggota TAK PERNAH dipakai (20261024_01);\n  token CourtListener pribadi untuk org itu tetap berlaku\n  (konektor, bukan kunci model).\nPerubahan tercatat di audit.", "autoResize": true, "lineHeight": 1.25}, {"id": "16cf145976ae440bbc31", "type": "rectangle", "x": 1640, "y": 430, "width": 760, "height": 253.5, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c0608f220c99417d9c22"], "frameId": null, "roundness": {"type": 3}, "seed": 68478755, "version": 1, "versionNonce": 1435897232, "isDeleted": false, "boundElements": [], "updated": 1793419175965, "link": null, "locked": false}, {"id": "f38c0e609edc434b9848", "type": "text", "x": 1654, "y": 444, "width": 195.9, "height": 22.5, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c0608f220c99417d9c22"], "frameId": null, "roundness": null, "seed": 1014818868, "version": 1, "versionNonce": 578842091, "isDeleted": false, "boundElements": null, "updated": 1793419175965, "link": null, "locked": false, "text": "4 · Arsip keberangkatan", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4 · Arsip keberangkatan", "autoResize": true, "lineHeight": 1.25}, {"id": "cb32bd475b84480b8829", "type": "text", "x": 1654, "y": 474.5, "width": 394.0, "height": 195.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c0608f220c99417d9c22"], "frameId": nul