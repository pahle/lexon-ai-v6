{
  "name": "@lexon/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node ../scripts/check-boundaries.mjs",
    "test": "vitest run --config ../vitest.config.ts --project backend-unit",
    "test:e2e": "node ../scripts/e2e.mjs --package backend",
    "dev": "node ../scripts/dev.mjs --package backend",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6"
  }
}
