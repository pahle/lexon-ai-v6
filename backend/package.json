{
  "name": "@lexon/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node ../scripts/check-boundaries.mjs",
    "test": "vitest run --config ../vitest.config.ts --project backend-unit --project backend-integration",
    "test:e2e": "node ../scripts/e2e.mjs --package backend",
    "dev": "node ../scripts/dev.mjs --package backend",
    "format": "prettier --write --ignore-path ../.prettierignore .",
    "test:fixtures:build": "tsc -p test/process/tsconfig.json",
    "test:mutation": "stryker run stryker.config.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@lexon/contracts": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/terminus": "12.1.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.159",
    "bullmq": "6.5.3",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.1"
  },
  "exports": {
    "./evaluation": {
      "types": "./dist/evaluation/index.d.ts",
      "import": "./dist/evaluation/index.js"
    }
  },
  "imports": {
    "#backend-package": "./package.json"
  }
}
