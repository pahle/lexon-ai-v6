roupIds": [], "frameId": null, "roundness": null, "seed": 1146154899, "version": 1, "versionNonce": 761489278, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "KELUAR / DIKELUARKAN", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "KELUAR / DIKELUARKAN", "autoResize": true, "lineHeight": 1.25}, {"id": "24416b6020f541c6b4b4", "type": "rectangle", "x": 60, "y": 130, "width": 1180, "height": 319.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["6393ff6c0b1a4afd99d4"], "frameId": null, "roundness": {"type": 3}, "seed": 568074362, "version": 1, "versionNonce": 1379624123, "isDeleted": false, "boundElements": [], "updated": 1793419175844, "link": null, "locked": false}, {"id": "12641a25b9914d61850a", "type": "text", "x": 74, "y": 144, "width": 429.6, "height": 23.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["6393ff6c0b1a4afd99d4"], "frameId": null, "roundness": null, "seed": 133444158, "version": 1, "versionNonce": 1911118618, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "Siapa boleh apa (diverifikasi dari kode & schema)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Siapa boleh apa (diverifikasi dari kode & schema)", "autoResize": true, "lineHeight": 1.25}, {"id": "59723864a4514c15ae59", "type": "text", "x": 74, "y": 175.8, "width": 594.3, "height": 260.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["6393ff6c0b1a4afd99d4"], "frameId": null, "roundness": null, "seed": 504705425, "version": 1, "versionNonce": 1966481966, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "tindakan                                      owner   admin       member\n--------------------------------------------------------------------------\nundang sebagai MEMBER                         ya      ya          -\nundang sebagai ADMIN                          ya      -           -\nubah peran anggota (PATCH members/:id)        ya      -           -\nkeluarkan MEMBER                              ya      ya          -\nkeluarkan ADMIN atau OWNER lain               ya      -           -\nkeluar sendiri (owner terakhir: tidak)        ya*     ya          ya\nubah nama org                                 ya      ya          -\nlihat roster                                  ya      ya          ya\nkunci API & daftar model org                  ya      ya          -\nlihat audit log org                           ya      ya          -\nkebijakan data anggota (ekspor/hapus)         ya      -           -\narsip keberangkatan (lihat/alihkan/hapus)     ya      -           -\nhapus / pulihkan organisasi                   ya      -           -\nbuka konten privat (per item, Viewer)         ya      izin owner  -", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "tindakan                                      owner   admin       member\n--------------------------------------------------------------------------\nundang sebagai MEMBER                         ya      ya          -\nundang sebagai ADMIN                          ya      -           -\nubah peran anggota (PATCH members/:id)        ya      -           -\nkeluarkan MEMBER                              ya      ya          -\nkeluarkan ADMIN atau OWNER lain               ya      -           -\nkeluar sendiri (owner terakhir: tidak)        ya*     ya          ya\nubah nama org                                 ya      ya          -\nlihat roster                                  ya      ya          ya\nkunci API & daftar model org                  ya      ya          -\nlihat audit log org                           ya      ya          -\nkebijakan data anggota (ekspor/hapus)         ya      -           -\narsip keberangkatan (lihat/alihkan/hapus)     ya      -           -\nhapus / pulihkan organisasi                   ya      -           -\nbuka konten privat (per item, Viewer)         ya      izin owner  -", "autoResize": true, "lineHeight": 1.25}, {"id": "26f0e1a991204eeb8855", "type": "rectangle", "x": 1320, "y": 130, "width": 1100, "height": 164.8, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["84ac0370dbdf4d89b64e"], "frameId": null, "roundness": {"type": 3}, "seed": 2017740357, "version": 1, "versionNonce": 224600099, "isDeleted": false, "boundElements": [], "updated": 1793419175844, "link": null, "locked": false}, {"id": "cf2d3355fe52499383b5", "type": "text", "x": 1334, "y": 144, "width": 127.3, "height": 23.8, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["84ac0370dbdf4d89b64e"], "frameId": null, "roundness": null, "seed": 858679287, "version": 1, "versionNonce": 908542044, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "Aturan penting", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Aturan penting", "autoResize": true, "lineHeight": 1.25}, {"id": "e45461ef6ac74acb9427", "type": "text", "x": 1334, "y": 175.8, "width": 745.1, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["84ac0370dbdf4d89b64e"], "frameId": null, "roundness": null, "seed": 782138005, "version": 1, "versionNonce": 1591458306, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "• Tiga peran: owner (boleh beberapa) · admin · member. Setiap org tim wajib punya ≥1 owner:\n  dijaga di layanan DAN trigger DB (org_members_protect_last_owner) — dua owner pergi bersamaan tak bisa lolos.\n• Perubahan peran diperiksa di DUA ujung (peran sekarang & peran baru): admin tak bisa menurunkan owner\n  maupun mengangkat member jadi owner. Dicatat di audit.\n• Peran org diwariskan ke proyek milik org, jadi perubahan peran = perubahan standing nyata.\n• Org 'personal' (satu per orang, kind='personal') tidak punya rute /orgs: refusePersonalOrg menolaknya.", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Tiga peran: owner (boleh beberapa) · admin · member. Setiap org tim wajib punya ≥1 owner:\n  dijaga di layanan DAN trigger DB (org_members_protect_last_owner) — dua owner pergi bersamaan tak bisa lolos.\n• Perubahan peran diperiksa di DUA ujung (peran sekarang & peran baru): admin tak bisa menurunkan owner\n  maupun mengangkat member jadi owner. Dicatat di audit.\n• Peran org diwariskan ke proyek milik org, jadi perubahan peran = perubahan standing nyata.\n• Org 'personal' (satu per orang, kind='personal') tidak punya rute /orgs: refusePersonalOrg menolaknya.", "autoResize": true, "lineHeight": 1.25}, {"id": "d3e07ae9968641f58d40", "type": "rectangle", "x": 60, "y": 500, "width": 520, "height": 188.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["a65b6cabcac442a29d1b"], "frameId": null, "roundness": {"type": 3}, "seed": 1572669917, "version": 1, "versionNonce": 1470831568, "isDeleted": false, "boundElements": [{"id": "e16b31b2167143a2abc6", "type": "arrow"}], "updated": 1793419175844, "link": null, "locked": false}, {"id": "a498f73fd5be473ba2d7", "type": "text", "x": 74, "y": 530.2, "width": 312.0, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["a65b6cabcac442a29d1b"], "frameId": null, "roundness": null, "seed": 1403992324, "version": 1, "versionNonce": 1640004642, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "POST /orgs/:id/invitations {email, role}", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "POST /orgs/:id/invitations {email, role}", "autoResize": true, "lineHeight": 1.25}, {"id": "6b9c209861bb40fe8556", "type": "text", "x": 74, "y": 560.8, "width": 350.0, "height": 97.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["a65b6cabcac442a29d1b"], "frameId": null, "roundness": null, "seed": 1426889642, "version": 1, "versionNonce": 369168774, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "admin+ · peran default 'member'; peran tak dikenal → 400\n'owner' TIDAK bisa diundang (tier itu tak ada di undangan)\nundang sebagai admin = keputusan owner\nsudah anggota → tak perlu undangan\nsatu undangan pending per (org, email); yang kedaluwarsa\n  dibuka ulang di tempat (bukan baris baru)", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "admin+ · peran default 'member'; peran tak dikenal → 400\n'owner' TIDAK bisa diundang (tier itu tak ada di undangan)\nundang sebagai admin = keputusan owner\nsudah anggota → tak perlu undangan\nsatu undangan pending per (org, email); yang kedaluwarsa\n  dibuka ulang di tempat (bukan baris baru)", "autoResize": true, "lineHeight": 1.25}, {"id": "fad24c75eb5449c294dd", "type": "rectangle", "x": 630, "y": 500, "width": 520, "height": 188.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["40432cc1402a4b41810f"], "frameId": null, "roundness": {"type": 3}, "seed": 1122300143, "version": 1, "versionNonce": 803131187, "isDeleted": false, "boundElements": [{"id": "e16b31b2167143a2abc6", "type": "arrow"}, {"id": "3095007dfacd4517b6b9", "type": "arrow"}], "updated": 1793419175844, "link": null, "locked": false}, {"id": "7212222230c74e0bbf70", "type": "text", "x": 644, "y": 538.4, "width": 262.9, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["40432cc1402a4b41810f"], "frameId": null, "roundness": null, "seed": 1814695175, "version": 1, "versionNonce": 1788735868, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "pending  (expires_at = +14 hari)", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "pending  (expires_at = +14 hari)", "autoResize": true, "lineHeight": 1.25}, {"id": "0fde9619d91e41588f6e", "type": "text", "x": 644, "y": 568.9, "width": 343.2, "height": 81.2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["40432cc1402a4b41810f"], "frameId": null, "roundness": null, "seed": 311784865, "version": 1, "versionNonce": 129690913, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "status: pending · accepted · declined · cancelled · expired\nadmin: GET /invitations · resend · DELETE (cancel)\npenerima: GET /user/invitations (daftar milikku)\ndetail undangan tak dicari dari email yang belum\n  terverifikasi", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "status: pending · accepted · declined · cancelled · expired\nadmin: GET /invitations · resend · DELETE (cancel)\npenerima: GET /user/invitations (daftar milikku)\ndetail undangan tak dicari dari email yang belum\n  terverifikasi", "autoResize": true, "lineHeight": 1.25}, {"id": "6ad77fb576c04626b150", "type": "rectangle", "x": 1200, "y": 500, "width": 600, "height": 188.5, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["532d9d394c6641d6b811"], "frameId": null, "roundness": {"type": 3}, "seed": 1681012168, "version": 1, "versionNonce": 1774723946, "isDeleted": false, "boundElements": [{"id": "3095007dfacd4517b6b9", "type": "arrow"}], "updated": 1793419175844, "link": null, "locked": false}, {"id": "81af645b15774b57a575", "type": "text", "x": 1214, "y": 514, "width": 110.3, "height": 22.5, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["532d9d394c6641d6b811"], "frameId": null, "roundness": null, "seed": 212992742, "version": 1, "versionNonce": 1031244724, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "Terima / tolak", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Terima / tolak", "autoResize": true, "lineHeight": 1.25}, {"id": "c7495a7930a94e7ea6dc", "type": "text", "x": 1214, "y": 544.5, "width": 378.9, "height": 130.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["532d9d394c6641d6b811"], "frameId": null, "roundness": null, "seed": 1831613829, "version": 1, "versionNonce": 1064032241, "isDeleted": false, "boundElements": null, "updated": 1793419175844, "link": null, "locked": false, "text": "terima = SATU-SATUNYA pintu munculnya baris\n  org_members (selain pembuat org)\nperan = LANTAI, bukan langit-langit: undangan admin\n  menaikkan member jadi admin; undangan member tak\n  pernah menurunkan admin/owner\nidempoten bila sudah anggota; audit mencatat peran\n  yang BERLAKU, bukan yang ditawarkan\nDiterima saat onboarding (layar 3) atau Settings › Organizations", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "terima = SATU-SATUNYA pintu munculnya baris\n  org_members (selain pembuat org)\nperan = LANTAI, bukan langit-langit: undangan admin\n  menaikkan member jadi admin; undangan member tak\n  pernah menurunkan admin/owner\nidempoten bila sudah anggota; audit mencatat peran\n  yang BERLAKU, bukan yang ditawarkan\nDiterima saat onboarding (layar 3) atau Settings › Organizations", "autoResize": true, "lineHeight": 1.25}, {"id": "d52bfd9931b644129c0e", "type": "rectangle", "x": 60, "y": 780, "width": 470, "height": 139.8, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["4550369a7c67456f922d"], "frameId": null, "roundness": {"type": 3}, "seed": 1287918687, "version": 1, "versionNonce": 1816841670, "isDeleted": false, "boundElements": [{"id": "59c84bf5cdfe429684d4", "type": "arrow"}], "updated": 1793419175844, "link": null, "locked": false}, {"id": "a99b3476918f4b929747", "type": "text", "x": 74, "y": 802.1, "wid