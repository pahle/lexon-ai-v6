   → frame content_delta; isi blok → citations(partial)\nonReasoningDelta → reasoning_delta\nonReasoningBlockEnd → event reasoning + reasoning_block_end\nonToolCallStart → flushText + tool_call_start;\n   subagent 'delegate' langsung dijalankan (tak menunggu step)\nonWebSearch (search native provider) → web_search / web_sources\nonUsage → jumlahkan token input & output\nonActivity → run.touch(): reset timer idle run\n\nSemua frame lewat sanitizeAssistantSseChunk:\npesan error tool/provider mentah diganti teks generik", "autoResize": true, "lineHeight": 1.25}, {"id": "e77e96f07801403d8110", "type": "rectangle", "x": 1630, "y": 270, "width": 780, "height": 322.2, "angle": 0, "strokeColor": "#d9480f", "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["41f44385de2f42c5b876"], "frameId": null, "roundness": {"type": 3}, "seed": 295968431, "version": 1, "versionNonce": 571953839, "isDeleted": false, "boundElements": [{"id": "116124af598442c3b3e8", "type": "arrow"}], "updated": 1793419172829, "link": null, "locked": false}, {"id": "32ed34275e7043f28f76", "type": "text", "x": 1644, "y": 284, "width": 271.9, "height": 23.8, "angle": 0, "strokeColor": "#d9480f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["41f44385de2f42c5b876"], "frameId": null, "roundness": null, "seed": 934994468, "version": 1, "versionNonce": 1372816080, "isDeleted": false, "boundElements": null, "updated": 1793419172829, "link": null, "locked": false, "text": "Isi runTools(calls) — satu batch", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Isi runTools(calls) — satu batch", "autoResize": true, "lineHeight": 1.25}, {"id": "0e6e7a78be2c40e39902", "type": "text", "x": 1644, "y": 315.8, "width": 477.1, "height": 262.5, "angle": 0, "strokeColor": "#1e1e1e",