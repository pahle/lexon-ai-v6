llStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["12489031f92b4a5db203"], "frameId": null, "roundness": null, "seed": 1383326199, "version": 1, "versionNonce": 800552222, "isDeleted": false, "boundElements": null, "updated": 1793419172829, "link": null, "locked": false, "text": "dipakai: chat · project-chat · word-chat · tabular · subagent", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "dipakai: chat · project-chat · word-chat · tabular · subagent", "autoResize": true, "lineHeight": 1.25}, {"id": "988e4b424fcd489e8277", "type": "rectangle", "x": 700, "y": 270, "width": 800, "height": 217.2, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["4885455b0ab9410c90d4"], "frameId": null, "roundness": {"type": 3}, "seed": 167136581, "version": 1, "versionNonce": 1751264025, "isDeleted": false, "boundElements": [{"id": "894744b6723e44dc9f12", "type": "arrow"}, {"id": "b9ae4e7e9b034527b513", "type": "arrow"}], "updated": 1793419172829, "link": null, "locked": false}, {"id": "1a94cf7fee3346208d0f", "type": "text", "x": 714, "y": 284, "width": 352.4, "height": 23.8, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["4885455b0ab9410c90d4"], "frameId": null, "roundness": null, "seed": 960095676, "version": 1, "versionNonce": 1610927926, "isDeleted": false, "boundElements": null, "updated": 1793419172829, "link": null, "locked": false, "text": "A · Persiapan (sebelum model dipanggil)", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A · Persiapan (sebelum model dipanggil)", "autoResize": true, "lineHeight": 1.25}, {"id": "f34b9a6e174b4c788dc1", "type": "text", "x": 714, "y": 315.8, "width": 573.2, "height": 157.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["4885455b0ab9410c90d4"], "frameId": null, "roundness": null, "seed": 1893253909, "version": 1, "versionNonce": 1396755674, "isDeleted": false, "boundElements": null, "updated": 1793419172829, "link": null, "locked": false, "text": "• connectorTools = MCP + Google Drive + Google Workspace milik workspace chat\n   (subagent memakai punya induknya)\n• baseTools = TOOLS + CourtListener (bila legal_research) + WORKFLOW + PLAYBOOK\n   + tool web + delegate (bila subagent diizinkan)\n• advertised = base + konektor + extraTools (proyek) + clientTools.schemas (Word)\n• permitted = advertised − tool penulis dokumen, bila !allowDocumentMutation\n• activeTools = permitted − SUBAGENT_EXCLUDED_TOOL_NAMES, bila ini subagent\n• systemPrompt = memory + prompt web search + prompt delegasi\n• chatMessages = riwayat tanpa giliran asisten kosong; memory.message di depan", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• connectorTools = MCP + Google Drive + Google Workspace milik workspace chat\n   (subagent memakai punya induknya)\n• baseTools = TOOLS + CourtListener (bila legal_research) + WORKFLOW + PLAYBOOK\n   + tool web + delegate (bila subagent diizinkan)\n• advertised = base + konektor + extraTools (proyek) + clientTools.schemas (Word)\n• permitted = advertised − tool penulis dokumen, bila !allowDocumentMutation\n• activeTools = permitted − SUBAGENT_EXCLUDED_TOOL_NAMES, bila ini subagent\n• systemPrompt = memory + prompt web search + prompt delegasi\n• chatMessages = riwayat tanpa giliran asisten kosong; memory.message di depan", "autoResize": true, "lineHeight": 1.25}, {"id": "368e31eb86d140e2b8b6", "type": "rectangle", "x": 700, "y": 590, "width": 800