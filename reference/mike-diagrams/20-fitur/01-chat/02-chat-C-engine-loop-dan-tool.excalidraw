d · doc_replicated ·\n   workflow_applied · doc_edited · courtlistener_* · mcp_tool_call ·\n   case_citation\n5  askInputsEvents → tulis frame, lalu THROW pause (loop berhenti)\n6  petakan hasil per tool_call_id dalam urutan panggilan model;\n   yang tak punya hasil → {\"error\":\"Tool 'x' is not available.\"}", "autoResize": true, "lineHeight": 1.25}, {"id": "9ce4bfd34e304de8ba8c", "type": "rectangle", "x": 1630, "y": 900, "width": 780, "height": 173.5, "angle": 0, "strokeColor": "#d9480f", "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["5e21d3e4c2404e7ba93e"], "frameId": null, "roundness": {"type": 3}, "seed": 236132318, "version": 1, "versionNonce": 56061395, "isDeleted": false, "boundElements": [{"id": "116124af598442c3b3e8", "type": "arrow"}], "updated": 1793419172829, "link": null, "locked": false}, {"id": "3e9cb45b5f6f4b60a377", "type": "text", "x": 1644, "y": 914, "width": 288.2, "height": 23.8, "angle": 0, "strokeColor": "#d9480f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["5e21d3e4c2404e7ba93e"], "frameId": null, "roundness": null, "seed": 1573962944, "version": 1, "versionNonce": 1088143001, "isDeleted": false, "boundElements": null, "updated": 1793419172829, "link": null, "locked": false, "text": "runToolCalls — dispatcher server", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "runToolCalls — dispatcher server", "autoResize": true, "lineHeight": 1.25}, {"id": "2d03ae2c99544caaae67", "type": "text", "x": 1644, "y": 945.8, "width": 682.6, "height": 113.8, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["5e21d3e4c2404e7ba93e"], "frameId": null, "roundness": null, "seed"