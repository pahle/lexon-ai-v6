umen).\nfind_in_document → satu dokumen.\nTeks diekstrak sekali oleh job, bukan per query.\nverifyCitations memakai teks yang sama →\nkutipan harus benar-benar ada di sumber.", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "find_documents → document_version_texts via pg_trgm (lintas dokumen).\nfind_in_document → satu dokumen.\nTeks diekstrak sekali oleh job, bukan per query.\nverifyCitations memakai teks yang sama →\nkutipan harus benar-benar ada di sumber.", "autoResize": true, "lineHeight": 1.25}, {"id": "a510ce383ffd429fa77c", "type": "rectangle", "x": 1890, "y": 430, "width": 570, "height": 200, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["203bf7daa9e94cf18b80"], "frameId": null, "roundness": {"type": 3}, "seed": 323889340, "version": 1, "versionNonce": 472610089, "isDeleted": false, "boundElements": [], "updated": 1793419173334, "link": null, "locked": false}, {"id": "20b21f91973e44cea827", "type": "text", "x": 1904, "y": 470.4, "width": 140.3, "height": 23.8, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["203bf7daa9e94cf18b80"], "frameId": null, "roundness": null, "seed": 1012197231, "version": 1, "versionNonce": 249857294, "isDeleted": false, "boundElements": null, "updated": 1793419173334, "link": null, "locked": false, "text": "Unduh & ekspor", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Unduh & ekspor", "autoResize": true, "lineHeight": 1.25}, {"id": "ca5e3c060db94015bfe5", "type": "text", "x": 1904, "y": 502.1, "width": 375.3, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "