# Replace placeholders locally. Never commit .env or usable credentials.
DATABASE_APP_URL=postgresql://lexon_app:REPLACE_ME@postgres:5432/lexon
VALKEY_QUEUE_URL=redis://:REPLACE_ME@valkey:6379/0
VALKEY_STREAMS_URL=redis://:REPLACE_ME@valkey:6379/0
VALKEY_LIMITER_URL=redis://:REPLACE_ME@valkey:6379/0
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=lexon-development
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_REGION=us-east-1
HEALTH_FILE=/run/lexon/health/status.json
HEALTH_WRITE_INTERVAL_MS=5000
HEALTH_STALE_MS=20000
DEPENDENCY_TIMEOUT_MS=2000
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=10000
DISPATCHER_POLL_MS=1000
DISPATCHER_RETRY_BASE_MS=250
DISPATCHER_RETRY_CAP_MS=30000
DISPATCHER_BATCH_SIZE=20
DISPATCHER_LEASE_MS=15000
QUEUE_ENQUEUE_TIMEOUT_MS=2000
PORT=3001

# Metadata only; F0 does not delete processed-job receipts.
JOB_RECEIPT_RETENTION_SECONDS=2592000
# Optional upload-caller endpoint; defaults to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:8333
QUEUE_PREFIX=bull

# Compose setup-only credentials; never passed to application/front-end services.
POSTGRES_ADMIN_PASSWORD=REPLACE_ME
DATABASE_NAME=lexon
DATABASE_MIGRATOR_PASSWORD=REPLACE_ME
DATABASE_APP_PASSWORD=REPLACE_ME
DATABASE_AUTH_PASSWORD=REPLACE_ME
VALKEY_PASSWORD=REPLACE_ME
API_HOST_PORT=3001
FRONTEND_HOST_PORT=3000

# API-only authentication and SMTP; use independent random secrets of at least 32 bytes.
AUTH_PUBLIC_ORIGIN=http://localhost:3000
AUTH_LOCAL_DEVELOPMENT=true
AUTH_SECRET=REPLACE_ME
AUTH_AUDIT_HMAC_SECRET=REPLACE_ME
AUTH_AUDIT_HMAC_KEY_ID=v1
AUTH_OPEN_SIGNUP=true
SMTP_URL=smtp://localhost:2525
SMTP_FROM=lexon@example.test
# pnpm dev --mail enables the ephemeral Mailpit catcher and its loopback UI.
MAILPIT_HOST_PORT=8025
# Operator-only password; never placed on the API or other runtime services.
DATABASE_SETUP_PASSWORD=REPLACE_ME
