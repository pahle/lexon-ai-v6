{
  "name": "lexon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": "24.x",
    "pnpm": "10.33.1"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --sort build",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project backend-unit",
    "test:e2e": "node scripts/e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
